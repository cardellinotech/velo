# Node environment
NODE_ENV=development

# PostgreSQL container credentials
POSTGRES_USER=velo
POSTGRES_PASSWORD=velo
POSTGRES_DB=velo

# App database connection (uses 'postgres' hostname = Docker Compose service name)
DATABASE_URL=postgresql://velo:velo@postgres:5432/velo

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production

# Public URL of the app (used by Auth.js for redirects)
NEXTAUTH_URL=http://localhost:3003
